[configuration]
entry_symbol = "GDExtensionInit"
compatibility_minimum = 4.1

[icons]
Example = "icons/Example.svg"

[libraries]
linux.release.x86_64 = "lib/Linux-x86_64/libgodot_rtmidi.so"
linux.release.arm64 =  "lib/Linux-aarch64/libgodot_rtmidi.so"
linux.arm64 =  "lib/Linux-aarch64/libgodot_rtmidi.so"
macos.release = "lib/Darwin-universal/libgodot_rtmidi.dylib"
windows.release.x86_64 = "lib/Windows-AMD64/godot_rtmidi.dll"
